APP_NAME="Sugeng Rawuh Billing & POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8008

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL Production Database (Docker service name: db)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_LOCAL_PORT=13306
DB_DATABASE=sugeng_rawuh_pos
DB_USERNAME=sugeng_pos
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# HTTP Host Port Binding
APP_PORT=8008

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=480

# IoT Hardware & Samsung Smart TV Control (G4 / G5)
# SAFETY FIRST: Physical network execution defaults to false until physical IP/MAC/Tokens are paired & verified!
HARDWARE_DRIVER=real
HARDWARE_REAL_EXECUTION_ENABLED=false
HARDWARE_REAL_ALLOWED_DEVICES=*
HARDWARE_SIMULATION_ENABLED=false
HARDWARE_AUTOMATION_ENABLED=true
HARDWARE_TIMEOUT_MS=3000
HARDWARE_CONNECT_TIMEOUT_MS=3000
HARDWARE_REQUEST_TIMEOUT_MS=5000
HARDWARE_APP_NAME="Sugeng Rawuh POS"
HARDWARE_SAMSUNG_WS_VERIFY_SSL=false

# PlayStation Console Notifications (SR-CONSOLE-ALERT-001)
# SAFETY FIRST: Keep CONSOLE_REAL_EXECUTION_ENABLED=false until PS3 webMAN / PS4 GoldHEN IPs are verified!
CONSOLE_NOTIFICATIONS_ENABLED=true
CONSOLE_NOTIFICATIONS_TRANSPORT=http
CONSOLE_REAL_EXECUTION_ENABLED=false
PS3_WEBMAN_PORT=80
PS3_HTTP_CONNECT_TIMEOUT_MS=2000
PS3_HTTP_TIMEOUT_MS=5000
PS4_NOTIFY_PORT=8080
PS4_NOTIFY_TIMEOUT_MS=2000
PS4_REAL_PROTOCOL_ENABLED=false

# Windows Host Wake-on-LAN (WOL) Helper Service (For Docker Desktop on Windows NAT Bridge)
HARDWARE_WOL_HELPER_ENABLED=true
HARDWARE_WOL_HELPER_URL=http://host.docker.internal:18009/wol
HARDWARE_WOL_HELPER_TOKEN=CHANGE_ME_WOL_SHARED_SECRET
HARDWARE_WOL_HELPER_TIMEOUT_MS=1500

